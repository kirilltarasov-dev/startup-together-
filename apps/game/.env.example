# Names only. Real values are stored ONLY in Vercel Project Settings -> Environment Variables,
# scoped to Production/Preview/Development. Never commit real values here or anywhere in git.
# See docs/HANDOFF.md, docs/VOICE.md, docs/DEVIN_CONTRACT.md for what each one does.

# --- Public (compiled into the browser bundle; must never hold a secret) ---
VITE_AGENT_MODE=mock          # mock | cached | live

# --- Server-only: read exclusively inside apps/game/api/** (Vercel serverless functions) ---
# Azure Foundry (GPT-Live voice route: apps/game/api/voice/session.ts)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_LIVE_DEPLOYMENT=
AZURE_RESPONSES_DEPLOYMENT=

# Railway orchestrator proxy (apps/game/api/missions/[...path].ts)
ORCH_URL=
ORCH_TOKEN=
