# Copy to .env for local dev (never commit .env). On Railway set these as service Variables.

# Devin v3 org API (service user key, cog_...). Unset => server runs in MOCK mode.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_URL=https://api.devin.ai/v3

# Force a mode instead of deriving it from DEVIN_API_KEY: live | cached | mock
# ORCH_MODE=mock

# Challenge repository Devin works on (constrained to CHALLENGE_PATH, pushes devin/* only)
CHALLENGE_REPO=kirilltarasov-dev/startup-together-
CHALLENGE_PATH=startup-repo
# main SHA the verifier trusts; candidates must descend from it
BASELINE_SHA=

# Shared secret; every /api/* route except /api/health requires header X-Runway-Key
ORCH_TOKEN=
# Comma-separated extra CORS origins (localhost:5173 is always allowed), e.g. https://runway.vercel.app
ALLOWED_ORIGIN=

# Railway injects PORT automatically
PORT=8000
MISSION_TIMEOUT_SEC=480
